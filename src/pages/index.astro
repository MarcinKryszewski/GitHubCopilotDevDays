---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllCategories, getAllGames, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Wesprzyj swoją nową ulubioną grę!">
  <div class="py-8">
    <PageHero
      title="Witaj w Tailspin Toys"
      subtitle="Znajdź swoją następną grę. A może nawet ją wesprzesz? Przejrzyj naszą kolekcję!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Polecane gry</h2>

      {games.length === 0 ? (
        <EmptyState text="Na razie nie ma żadnych gier." />
      ) : (
        <>
          <section
            class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6"
            aria-labelledby="game-filters-heading"
            data-testid="game-filters"
          >
            <h3 id="game-filters-heading" class="text-lg font-semibold text-slate-100 mb-4">
              Filtruj gry
            </h3>
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              <fieldset>
                <legend class="mb-3 text-sm font-medium text-slate-200">Kategorie</legend>
                <div class="flex flex-wrap gap-3">
                  {categories.map((category) => (
                    <button
                      type="button"
                      aria-pressed="false"
                      data-category-id={category.id}
                      class="rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-300 transition-colors duration-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${category.id}`}
                    >
                      {category.name}
                    </button>
                  ))}
                </div>
              </fieldset>

              <div>
                <label for="publisher-filter" class="mb-3 block text-sm font-medium text-slate-200">
                  Wydawca
                </label>
                <select
                  id="publisher-filter"
                  name="publisher"
                  class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                  data-testid="publisher-filter"
                >
                  <option value="">Wszyscy wydawcy</option>
                  {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                  ))}
                </select>
              </div>
            </div>
            <button
              type="button"
              class="mt-6 rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors duration-200 hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-50"
              disabled
              data-testid="filter-reset"
            >
              Wyczyść filtry
            </button>
          </section>

          <p class="mb-4 text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-results-count">
            Liczba wyników: {games.length}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>
          <p
            class="mt-6 rounded-xl border border-slate-700 bg-slate-800 p-6 text-center text-slate-300"
            hidden
            data-testid="filter-empty-state"
          >
            Brak gier spełniających wybrane filtry.
          </p>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('[data-testid="game-filters"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty-state"]');
  const resetButton = filters?.querySelector<HTMLButtonElement>('[data-testid="filter-reset"]');

  if (filters && grid && resultCount && emptyState && resetButton) {
    const categoryButtons = Array.from(
      filters.querySelectorAll<HTMLButtonElement>('[data-category-id]'),
    );
    const publisherSelect = filters.querySelector<HTMLSelectElement>('select[name="publisher"]');
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));

    const updateVisibleGames = (): void => {
      const selectedCategories = categoryButtons
        .filter((button) => button.getAttribute('aria-pressed') === 'true')
        .map((button) => button.dataset.categoryId ?? '');
      const selectedPublisher = publisherSelect?.value ?? '';
      let visibleCount = 0;

      for (const card of cards) {
        const cardCategories = (card.dataset.gameCategoryIds ?? '').split(',').filter(Boolean);
        const matchesCategories = selectedCategories.every((categoryId) =>
          cardCategories.includes(categoryId),
        );
        const matchesPublisher =
          selectedPublisher.length === 0 || card.dataset.gamePublisherId === selectedPublisher;
        const isVisible = matchesCategories && matchesPublisher;

        card.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      }

      resultCount.textContent = `Liczba wyników: ${visibleCount}`;
      emptyState.hidden = visibleCount > 0;
      resetButton.disabled = selectedCategories.length === 0 && selectedPublisher.length === 0;
    };

    for (const button of categoryButtons) {
      button.addEventListener('click', () => {
        const isPressed = button.getAttribute('aria-pressed') === 'true';
        button.setAttribute('aria-pressed', String(!isPressed));
        button.classList.toggle('bg-blue-600', !isPressed);
        button.classList.toggle('border-blue-400', !isPressed);
        button.classList.toggle('text-white', !isPressed);
        button.classList.toggle('bg-slate-900', isPressed);
        button.classList.toggle('border-slate-600', isPressed);
        button.classList.toggle('text-slate-300', isPressed);
        updateVisibleGames();
      });
    }

    publisherSelect?.addEventListener('change', updateVisibleGames);
    resetButton.addEventListener('click', () => {
      for (const button of categoryButtons) {
        button.setAttribute('aria-pressed', 'false');
        button.classList.remove('bg-blue-600', 'border-blue-400', 'text-white');
        button.classList.add('bg-slate-900', 'border-slate-600', 'text-slate-300');
      }

      if (publisherSelect) publisherSelect.value = '';
      updateVisibleGames();
    });
  }
</script>
